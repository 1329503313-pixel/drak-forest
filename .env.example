# 复制为 .env 后填写；不要把含真实密码的 .env 提交到 Git

# 本地 npm run dev（Node 直连数据库）——必填
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=darkforest
MYSQL_PASSWORD=请设置应用库用户密码
MYSQL_DATABASE=dark_forest

# docker-compose 拉起 MySQL 容器时还会读取 root 密码（与应用账号一起在 compose 里配置）
MYSQL_ROOT_PASSWORD=请设置强密码

# 可选：宿主机映射端口（默认 3306 / 80）
# MYSQL_PUBLISH_PORT=3306
# APP_PUBLISH_PORT=80
